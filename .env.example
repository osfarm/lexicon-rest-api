HOST=0.0.0.0 #The application is on all available network interfaces
PORT=8888 #The application runs on port 8888
DB_HOST=lexicon.osfarm.org #The database server address
DB_PORT=5432 #port used to connect to the database
DB_USER=your_user #Database connection ID
DB_PASSWORD=your_password #Password for the database user
DB_NAME=lexicon #database name
DB_SCHEMA=lexicon__6_0_0-ekyviti #the version you want in the lexicon
#DB_ACCESS_SCHEMA=lexicon_access #where API keys, plans and usage are stored (created at start)
#ACCESS_CONTROL=off #disables API keys and rate limiting
#PACKAGES_URL=https://lexicon-packages.osfarm.org #public address of the packages repository, for the download links of the catalogue
#BUNDLES_ROOT=/bundles #directory of the private bundles handed out under /bundles/<flavor>/ to the keys carrying the scope bundle:<flavor>
#TRUSTED_PROXIES=1 #reverse proxies in front of the API whose X-Forwarded-For entry is believed (0 when exposed directly)
# Duke, the assistant of /tools/assistant (optional: without a key the tool shows as unavailable)
#ASSISTANT_API_KEY= #key of the provider of the language model
#ASSISTANT_API_URL=https://api.mistral.ai/v1 #any provider speaking "chat completions"
#ASSISTANT_MODEL=ministral-8b-latest #default model, an administrator can change it in /admin/assistant
#ASSISTANT_MIN_INTERVAL_MS=400 #pause between two calls to the provider
#ASSISTANT_DAILY_ANONYMOUS=10 #questions a day for a caller without key
#ASSISTANT_DAILY_KEY=50 #questions a day for the holder of a key
#ASSISTANT_DAILY_TOTAL=500 #questions a day, everyone together
